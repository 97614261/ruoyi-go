{{define "header"}}<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{.Title}} · {{.SiteName}}</title><meta name="description" content="{{.Description}}">{{if .Canonical}}<link rel="canonical" href="{{.Canonical}}">{{end}}{{if .NoIndex}}<meta name="robots" content="noindex,nofollow">{{end}}{{if .Icon}}<link rel="icon" href="/media/{{.Icon}}">{{end}}<link rel="stylesheet" href="/assets/portal/{{if .Theme}}{{.Theme}}{{else}}business{{end}}/{{if .ThemeVersion}}{{.ThemeVersion}}{{else}}v3{{end}}/site.css"></head><body class="palette-{{.Palette}} density-{{.Density}} font-{{.FontScale}} width-{{.FrameWidth}} radius-{{.Radius}}"><a class="skip" href="#main">跳转正文</a><header class="site-header"><a class="brand" href="/">{{if .Logo}}<img class="logo" src="/media/{{.Logo}}" alt="">{{end}}{{.SiteName}}</a><nav aria-label="主导航"><a href="/">首页</a><a href="/products">产品展示</a><a href="/news">新闻动态</a><a href="/search">站内搜索</a>{{range .Links}}<a href="{{.URL}}" rel="noopener noreferrer">{{.Title}}</a>{{end}}</nav></header><main id="main">{{end}}
{{define "footer"}}</main><footer class="site-footer"><span>{{.SiteName}}</span><span>{{.Footer}}</span>{{if .Phone}}<span>{{.Phone}}</span>{{end}}{{if .Email}}<span>{{.Email}}</span>{{end}}{{range .FooterLinks}}<a href="{{.URL}}" rel="noopener noreferrer">{{.Title}}</a>{{end}}<a href="/sitemap.xml">站点地图</a></footer></body></html>{{end}}
{{define "cards"}}<div class="cards">{{range .}}<article class="card">{{if .Cover}}<a href="{{.URL}}" tabindex="-1" aria-hidden="true"><img src="/media/{{.Cover}}" alt="" loading="lazy" width="600" height="400"></a>{{end}}<div class="card-text"><span class="eyebrow">{{if eq .Kind "PRODUCT"}}产品{{else if eq .Kind "ARTICLE"}}动态{{else}}介绍{{end}}</span><h2><a href="{{.URL}}">{{.Title}}</a></h2><p>{{.Summary}}</p><a class="read" href="{{.URL}}">查看详情 →</a></div></article>{{else}}<p class="empty">内容正在整理中，欢迎稍后浏览。</p>{{end}}</div>{{end}}
{{define "home"}}{{template "header" .}}<section class="hero editorial-lead"><div><span class="eyebrow">资讯与阅读</span><h1>资讯与观点，<br>在这里汇集。</h1><p>{{.Description}}</p><a class="button" href="/products">浏览产品 →</a></div><div class="hero-aside"><span>从这里开始</span><a href="/products">产品展示 <b>↗</b></a><a href="/news">新闻动态 <b>↗</b></a><a href="/search">查找资料 <b>↗</b></a></div></section>{{if .Banners}}<section class="carousel" aria-label="轮播图（可横向滚动）">{{range .Banners}}<figure>{{if .URL}}<a href="{{.URL}}">{{end}}<img src="/media/{{.AssetId}}" alt="{{.Title}}"><figcaption>{{.Title}}</figcaption>{{if .URL}}</a>{{end}}</figure>{{end}}</section>{{end}}{{range .Sections}}<section class="section"><div class="section-head"><h2>{{.Title}}</h2><a href="{{.URL}}">查看全部 →</a></div>{{template "cards" .Cards}}</section>{{end}}{{template "footer" .}}{{end}}
{{define "column"}}{{template "header" .}}<section class="page-heading"><span class="eyebrow">EXPLORE</span><h1>{{.Title}}</h1><p>{{.Description}}</p><nav class="categories" aria-label="栏目">{{range .Channels}}<a href="{{.URL}}">{{.Title}}</a>{{end}}</nav></section>{{template "cards" .Cards}}{{template "pagination" .}}{{template "footer" .}}{{end}}
{{define "pagination"}}<nav class="pagination" aria-label="分页">{{if .Prev}}<a rel="prev" href="{{.Prev}}">← 上一页</a>{{end}}{{if .Next}}<a rel="next" href="{{.Next}}">下一页 →</a>{{end}}</nav>{{end}}
{{define "article"}}{{template "header" .}}<article class="reading"><a class="read" href="/news">← 新闻动态</a><h1>{{.Title}}</h1>{{if .Author}}<p class="muted">{{.Author}}</p>{{end}}{{if .Cover}}<img class="cover" src="/media/{{.Cover}}" alt="{{.CoverAlt}}">{{end}}<div class="prose">{{.BodyHTML}}{{.Body}}</div></article>{{template "footer" .}}{{end}}
{{define "page"}}{{template "header" .}}<article class="reading"><h1>{{.Title}}</h1>{{if .Cover}}<img class="cover" src="/media/{{.Cover}}" alt="{{.CoverAlt}}">{{end}}<div class="prose">{{.BodyHTML}}{{.Body}}</div></article>{{template "footer" .}}{{end}}
{{define "product"}}{{template "header" .}}<section class="product-head"><div>{{if .Cover}}<img class="cover" src="/media/{{.Cover}}" alt="{{.CoverAlt}}">{{else}}<div class="no-cover">{{.Title}}</div>{{end}}</div><div><a class="read" href="/products">← 产品展示</a><h1>{{.Title}}</h1>{{if .ProductCode}}<p class="muted">产品编号：{{.ProductCode}}</p>{{end}}<p>{{.Description}}</p>{{if .ProductParams}}<h2>产品参数</h2><pre class="parameters">{{.ProductParams}}</pre>{{end}}</div></section>{{if .Gallery}}<section class="gallery" aria-label="产品图集">{{range .Gallery}}<a href="/media/{{.}}"><img src="/media/{{.}}" alt="产品展示图片" loading="lazy"></a>{{end}}</section>{{end}}<section class="reading"><h2>产品详情</h2><div class="prose">{{.BodyHTML}}{{.Body}}</div></section>{{template "footer" .}}{{end}}
{{define "search"}}{{template "header" .}}<section class="page-heading"><span class="eyebrow">SEARCH</span><h1>查找你需要的内容</h1><form action="/search" method="get" class="search-form"><label for="q">关键词</label><input id="q" name="q" value="{{.Query}}" maxlength="80" placeholder="搜索产品、新闻与介绍"><button type="submit">搜索 →</button></form></section>{{template "cards" .Cards}}{{template "pagination" .}}{{template "footer" .}}{{end}}
{{define "notfound"}}{{template "header" .}}<section class="page-heading error"><span class="eyebrow">404</span><h1>页面不存在或已下架</h1><p>你可以返回首页，或搜索其他内容。</p><a class="button" href="/">返回首页 →</a></section>{{template "footer" .}}{{end}}
{{define "error"}}{{template "header" .}}<section class="page-heading error"><span class="eyebrow">暂时无法加载</span><h1>请稍后再试</h1><p>页面暂时不可用。</p><a class="button" href="/">返回首页 →</a></section>{{template "footer" .}}{{end}}
