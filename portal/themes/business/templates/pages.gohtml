{{define "header"}}<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{.Title}} · {{.SiteName}}</title><meta name="description" content="{{.Description}}">{{if .Canonical}}<link rel="canonical" href="{{.Canonical}}">{{end}}{{if .NoIndex}}<meta name="robots" content="noindex,nofollow">{{end}}{{if .Icon}}<link rel="icon" href="/media/{{.Icon}}">{{end}}<link rel="stylesheet" href="/assets/portal/{{if .Theme}}{{.Theme}}{{else}}business{{end}}/{{if .ThemeVersion}}{{.ThemeVersion}}{{else}}v3{{end}}/site.css">{{if .ListingLayout}}<link rel="stylesheet" href="/assets/portal/{{.Theme}}/{{.ThemeVersion}}/listing-v1.css">{{end}}<meta property="og:title" content="{{.ShareTitle}}"><meta property="og:description" content="{{.ShareDescription}}"><meta property="og:type" content="{{.ShareType}}"><meta property="og:site_name" content="{{.SiteName}}">{{if .Canonical}}<meta property="og:url" content="{{.Canonical}}">{{end}}{{if .ShareImage}}<meta property="og:image" content="{{.ShareImage}}"><meta property="og:image:alt" content="{{.ShareTitle}}">{{end}}{{if .Structured}}<script type="application/ld+json">{{.Structured}}</script>{{end}}<link rel="stylesheet" href="/assets/portal/{{.Theme}}/{{.ThemeVersion}}/growth-v1.css"></head><body class="{{if .IsListing}}listing-{{.ListingLayout}} {{end}}palette-{{.Palette}} density-{{.Density}} font-{{.FontScale}} width-{{.FrameWidth}} radius-{{.Radius}}"><a class="skip" href="#main">跳转正文</a><header class="site-header"><a class="brand" href="/">{{if .Logo}}<img class="logo" src="/media/{{.Logo}}" alt="">{{end}}{{.SiteName}}</a><nav aria-label="主导航"><a href="/">首页</a><a href="/products">产品展示</a><a href="/news">新闻动态</a><a href="/search">站内搜索</a><a href="/downloads">资料下载</a><a href="/inquiry">联系与留言</a>{{range .Links}}<a href="{{.URL}}" rel="noopener noreferrer">{{.Title}}</a>{{end}}</nav></header><main id="main">{{end}}
{{define "footer"}}</main><footer class="site-footer"><span>{{.SiteName}}</span><span>{{.Footer}}</span>{{if .Phone}}<span>{{.Phone}}</span>{{end}}{{if .Email}}<span>{{.Email}}</span>{{end}}{{range .FooterLinks}}<a href="{{.URL}}" rel="noopener noreferrer">{{.Title}}</a>{{end}}<a href="/sitemap.xml">站点地图</a></footer></body></html>{{end}}
{{define "cards"}}<div class="cards">{{range .}}<article class="card">{{if .Cover}}<a href="{{.URL}}" tabindex="-1" aria-hidden="true"><img src="/media/{{.Cover}}" alt="" loading="lazy" width="600" height="400"></a>{{end}}<div class="card-text"><span class="eyebrow">{{if eq .Kind "PRODUCT"}}产品{{else if eq .Kind "ARTICLE"}}动态{{else}}介绍{{end}}</span><h2><a href="{{.URL}}">{{if .TitleParts}}{{range .TitleParts}}{{if .Match}}<mark>{{.Text}}</mark>{{else}}{{.Text}}{{end}}{{end}}{{else}}{{.Title}}{{end}}</a></h2><p>{{if .SummaryParts}}{{range .SummaryParts}}{{if .Match}}<mark>{{.Text}}</mark>{{else}}{{.Text}}{{end}}{{end}}{{else}}{{.Summary}}{{end}}</p><a class="read" href="{{.URL}}">查看详情 →</a></div></article>{{else}}<p class="empty">内容正在整理中，欢迎稍后浏览。</p>{{end}}</div>{{end}}
{{define "home"}}{{template "header" .}}<section class="hero"><div><span class="eyebrow">产品与服务</span><h1>了解产品，<br>发现更多。</h1><p>{{.Description}}</p><a class="button" href="/products">浏览产品 →</a></div><div class="hero-aside"><span>从这里开始</span><a href="/products">产品展示 <b>↗</b></a><a href="/news">新闻动态 <b>↗</b></a><a href="/search">查找资料 <b>↗</b></a></div></section>{{if .Banners}}<section class="carousel" aria-label="轮播图（可横向滚动）">{{range .Banners}}<figure>{{if .URL}}<a href="{{.URL}}">{{end}}<img src="/media/{{.AssetId}}" alt="{{.Title}}"><figcaption>{{.Title}}</figcaption>{{if .URL}}</a>{{end}}</figure>{{end}}</section>{{end}}{{range .Sections}}{{if .Items}}{{template "growth-widget" .}}{{else if or (eq .Kind "ARTICLE") (eq .Kind "PRODUCT") (eq .Kind "PAGE")}}<section class="section"><div class="section-head"><h2>{{.Title}}</h2>{{if .URL}}<a href="{{.URL}}">查看全部 →</a>{{end}}</div>{{template "cards" .Cards}}</section>{{end}}{{end}}{{template "footer" .}}{{end}}
{{define "column"}}{{template "header" .}}<section class="page-heading"><span class="eyebrow">EXPLORE</span><h1>{{.Title}}</h1><p>{{.Description}}</p><nav class="categories" aria-label="栏目">{{range .Channels}}<a href="{{.URL}}">{{.Title}}</a>{{end}}</nav></section>{{template "cards" .Cards}}{{template "pagination" .}}{{template "footer" .}}{{end}}
{{define "pagination"}}<nav class="pagination" aria-label="分页">{{if .Prev}}<a rel="prev" href="{{.Prev}}">← 上一页</a>{{end}}{{if .Next}}<a rel="next" href="{{.Next}}">下一页 →</a>{{end}}</nav>{{end}}
{{define "article"}}{{template "header" .}}<article class="reading"><a class="read" href="/news">← 新闻动态</a><h1>{{.Title}}</h1>{{if .Author}}<p class="muted">{{.Author}}</p>{{end}}{{if .Cover}}<img class="cover" src="/media/{{.Cover}}" alt="{{.CoverAlt}}">{{end}}<div class="prose">{{.BodyHTML}}{{.Body}}</div></article>{{template "growth-related" .}}{{template "footer" .}}{{end}}
{{define "page"}}{{template "header" .}}<article class="reading"><h1>{{.Title}}</h1>{{if .Cover}}<img class="cover" src="/media/{{.Cover}}" alt="{{.CoverAlt}}">{{end}}<div class="prose">{{.BodyHTML}}{{.Body}}</div></article>{{template "growth-related" .}}{{template "footer" .}}{{end}}
{{define "product"}}{{template "header" .}}<section class="product-head"><div>{{if .Cover}}<img class="cover" src="/media/{{.Cover}}" alt="{{.CoverAlt}}">{{else}}<div class="no-cover">{{.Title}}</div>{{end}}</div><div><a class="read" href="/products">← 产品展示</a><h1>{{.Title}}</h1>{{if .ProductCode}}<p class="muted">产品编号：{{.ProductCode}}</p>{{end}}<p>{{.Description}}</p>{{if .ProductParams}}<h2>产品参数</h2><pre class="parameters">{{.ProductParams}}</pre>{{end}}</div></section>{{if .Gallery}}<section class="gallery" aria-label="产品图集">{{range .Gallery}}<a href="/media/{{.}}"><img src="/media/{{.}}" alt="产品展示图片" loading="lazy"></a>{{end}}</section>{{end}}<section class="reading"><h2>产品详情</h2><div class="prose">{{.BodyHTML}}{{.Body}}</div></section>{{template "growth-related" .}}{{template "footer" .}}{{end}}
{{define "search"}}{{template "header" .}}<section class="page-heading"><span class="eyebrow">SEARCH</span><h1>查找你需要的内容</h1><form action="/search" method="get" class="search-form"><label for="q">关键词</label><input id="q" name="q" value="{{.Query}}" maxlength="80" placeholder="搜索标题、摘要和正文，多个词用空格分隔"><button type="submit">搜索 →</button></form></section>{{template "cards" .Cards}}{{template "pagination" .}}{{template "footer" .}}{{end}}
{{define "notfound"}}{{template "header" .}}<section class="page-heading error"><span class="eyebrow">404</span><h1>页面不存在或已下架</h1><p>你可以返回首页，或搜索其他内容。</p><a class="button" href="/">返回首页 →</a></section>{{template "footer" .}}{{end}}
{{define "error"}}{{template "header" .}}<section class="page-heading error"><span class="eyebrow">暂时无法加载</span><h1>请稍后再试</h1><p>页面暂时不可用。</p><a class="button" href="/">返回首页 →</a></section>{{template "footer" .}}{{end}}

{{define "inquiry"}}{{template "header" .}}<section class="reading"><h1>联系与留言</h1><p>仅用于回复您的咨询。请勿填写密码、证件号码等敏感信息。</p><form method="post" action="/inquiry"><input type="hidden" name="token" value="{{.Query}}"><p><label>称呼 <input name="name" required maxlength="60" autocomplete="name"></label></p><p><label>联系方式（邮箱或电话） <input name="contact" required maxlength="120" autocomplete="email"></label></p><p><label>留言内容 <textarea name="message" required maxlength="2000" rows="6" style="width:100%"></textarea></label></p><div hidden aria-hidden="true"><label>网站（请留空）<input name="website" tabindex="-1" autocomplete="off"></label></div><p><label><input type="checkbox" name="consent" value="yes" required>我同意仅用于本次咨询联系</label></p><p>填写后请稍候再提交，每小时最多5次；页面10分钟内有效。</p><button type="submit">提交留言</button></form></section>{{template "footer" .}}{{end}}

{{define "growth-related"}}{{if .Tags}}<nav class="growth-tags" aria-label="内容标签">{{range .Tags}}<a href="{{.URL}}">{{.Title}}</a>{{end}}</nav>{{end}}{{if .Related}}<section class="section"><h2>相关内容</h2>{{template "cards" .Related}}</section>{{end}}{{end}}
{{define "growth-widget"}}<section class="section growth-widget growth-{{.Layout}}"><h2>{{.Title}}</h2><div class="growth-items">{{range .Items}}{{if eq $.Kind "FAQ"}}<details><summary>{{.Title}}</summary><p>{{.Text}}</p>{{if .URL}}<a href="{{.URL}}">了解详情</a>{{end}}</details>{{else}}<article>{{if .AssetId}}<img src="/media/{{.AssetId}}" alt="{{.Title}}" loading="lazy">{{end}}<h3>{{if .URL}}<a href="{{.URL}}">{{.Title}}</a>{{else}}{{.Title}}{{end}}</h3><p>{{.Text}}</p></article>{{end}}{{end}}</div></section>{{end}}
{{define "downloads"}}{{template "header" .}}<section class="page-heading"><h1>资料下载中心</h1><p>查找公开的产品资料、指南与文档。</p><form action="/downloads" method="get" class="search-form"><label>标题前缀 <input name="title" value="{{.Query}}" maxlength="120" placeholder="输入资料标题开头"></label><label>分类 <select name="categoryId"><option value="0">全部分类</option>{{range .DownloadCategories}}<option value="{{.Id}}" {{if eq $.DownloadCategoryId .Id}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><button type="submit">查询</button></form><nav aria-label="资料分类分页">{{if .DownloadCategoryPrev}}<a href="{{.DownloadCategoryPrev}}">上一组分类</a>{{end}} {{if .DownloadCategoryNext}}<a href="{{.DownloadCategoryNext}}">下一组分类</a>{{end}}</nav></section><section class="reading">{{range .Downloads}}<article class="card"><div class="card-text"><h2>{{.Title}}</h2><p>{{.Summary}}</p><p>{{.Category}} · {{.Extension}} · {{.Size}} 字节</p><p>{{.FileName}}</p><a class="button" href="/downloads/{{.Id}}/file">下载附件</a><details><summary>文件SHA256</summary><p style="overflow-wrap:anywhere">{{.SHA256}}</p></details></div></article>{{else}}<p class="empty">当前没有符合条件的公开资料。</p>{{end}}</section>{{template "pagination" .}}{{template "footer" .}}{{end}}
